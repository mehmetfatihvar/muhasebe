<Window x:Class="MuhasebeSistemi.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏢 Firma Muhasebe ve Kasa Takip Sistemi"
        Height="800" Width="1280" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>   <!-- Üst bar -->
            <RowDefinition Height="Auto"/> <!-- KPI bar -->
            <RowDefinition Height="*"/>    <!-- Tab içeriği -->
            <RowDefinition Height="28"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── ÜST BAR ──────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <TextBlock Text="🏢  MUHASEBE SİSTEMİ" VerticalAlignment="Center"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource Accent2Brush}"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" DockPanel.Dock="Right">
                    <Button Content="💾  Yedekle" Style="{StaticResource SecondaryBtn}"
                            Margin="0,0,8,0" Click="Yedekle_Click" Padding="14,8"/>
                    <Button Content="📂  Yedek Yükle" Style="{StaticResource SecondaryBtn}"
                            Click="YedekYukle_Click" Padding="14,8"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── KPI BAR ──────────────────────────────────────────────── -->
        <Border Grid.Row="1" Background="{StaticResource BgBrush}" Padding="20,12,20,12">
            <UniformGrid x:Name="KpiGrid" Columns="5" Rows="1">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="GÜNCEL KASA" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text3Brush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="KpiKasa" Text="₺0,00" FontSize="22" FontWeight="Bold"
                                   FontFamily="Courier New" Foreground="{StaticResource Accent2Brush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="BU AY GELİR" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text3Brush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="KpiGelir" Text="₺0,00" FontSize="22" FontWeight="Bold"
                                   FontFamily="Courier New" Foreground="{StaticResource GreenBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="BU AY GİDER" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text3Brush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="KpiGider" Text="₺0,00" FontSize="22" FontWeight="Bold"
                                   FontFamily="Courier New" Foreground="{StaticResource RedBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="NET DURUM" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text3Brush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="KpiNet" Text="₺0,00" FontSize="22" FontWeight="Bold"
                                   FontFamily="Courier New" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="SON 7 GÜN" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text3Brush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="KpiSon7" Text="0 işlem" FontSize="22" FontWeight="Bold"
                                   FontFamily="Courier New" Foreground="{StaticResource TextBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ── TAB CONTROL ──────────────────────────────────────────── -->
        <TabControl Grid.Row="2" x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">
            <TabItem Header="🏠  Ana Sayfa"      x:Name="TabAnaSayfa"/>
            <TabItem Header="➕  Gider Ekle"     x:Name="TabGider"/>
            <TabItem Header="💰  Gelir Ekle"     x:Name="TabGelir"/>
            <TabItem Header="🏦  Kasa Girişi"    x:Name="TabKasa"/>
            <TabItem Header="📋  Kalem Tanımları" x:Name="TabKalemler"/>
            <TabItem Header="🗂  Tüm Hareketler" x:Name="TabHareketler"/>
            <TabItem Header="📊  Gelir/Gider"    x:Name="TabTablo"/>
            <TabItem Header="📈  Raporlar"       x:Name="TabRaporlar"/>
        </TabControl>

        <!-- ── STATUS BAR ───────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Sistem hazır."
                       Foreground="{StaticResource Text2Brush}"
                       FontSize="12" VerticalAlignment="Center" Margin="16,0"/>
        </Border>
    </Grid>
</Window>
